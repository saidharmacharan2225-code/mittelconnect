#cloud-config
# MittelConnect site host: ${site_name}
# Rendered by Terraform (templatefile). Runs once on first boot.

disable_root: true
ssh_pwauth: false

users:
  - name: deploy
    gecos: MittelConnect operator
    shell: /bin/bash
    groups: [sudo]
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
      - ${admin_ssh_public_key}

package_update: true
package_upgrade: true
packages:
  - ca-certificates
  - curl
  - gnupg
  - jq
  - rsync
  - wireguard
  - unattended-upgrades
  - fail2ban

write_files:
  - path: /etc/ssh/sshd_config.d/90-mittelconnect.conf
    permissions: "0644"
    content: |
      PermitRootLogin no
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      X11Forwarding no
      AllowAgentForwarding no
      MaxAuthTries 3
      LoginGraceTime 30
      AllowUsers deploy

  - path: /etc/fail2ban/jail.d/sshd.local
    permissions: "0644"
    content: |
      [sshd]
      enabled = true
      backend = systemd
      maxretry = 5
      bantime = 1h

  - path: /etc/apt/apt.conf.d/52mittelconnect-unattended
    permissions: "0644"
    content: |
      Unattended-Upgrade::Allowed-Origins {
        "$${distro_id}:$${distro_codename}";
        "$${distro_id}:$${distro_codename}-security";
        "$${distro_id}ESMApps:$${distro_codename}-apps-security";
        "$${distro_id}ESM:$${distro_codename}-infra-security";
        "Docker:$${distro_codename}";
      };
      Unattended-Upgrade::Automatic-Reboot "true";
      Unattended-Upgrade::Automatic-Reboot-Time "03:30";
      Unattended-Upgrade::Remove-Unused-Dependencies "true";

  - path: /etc/apt/apt.conf.d/20auto-upgrades
    permissions: "0644"
    content: |
      APT::Periodic::Update-Package-Lists "1";
      APT::Periodic::Unattended-Upgrade "1";

  - path: /etc/docker/daemon.json
    permissions: "0644"
    content: |
      {
        "log-driver": "json-file",
        "log-opts": { "max-size": "20m", "max-file": "10" },
        "live-restore": true,
        "no-new-privileges": true,
        "userland-proxy": false,
        "icc": false
      }

  - path: /etc/sysctl.d/90-mittelconnect.conf
    permissions: "0644"
    content: |
      net.ipv4.ip_forward = 1
      net.ipv4.conf.all.rp_filter = 1
      net.ipv4.conf.all.accept_redirects = 0
      net.ipv4.conf.all.send_redirects = 0
      net.ipv6.conf.all.accept_redirects = 0
      kernel.kptr_restrict = 2
      kernel.dmesg_restrict = 1

  - path: /etc/mittelconnect/host.env
    permissions: "0644"
    content: |
      MC_SITE_NAME=${site_name}
      MCMON_BIND=${private_ip}
      MC_DATA_DEVICE=${volume_device}

  - path: /usr/local/sbin/mc-mount-data
    permissions: "0750"
    content: |
      #!/bin/bash
      # Mounts the Hetzner data volume at /srv/mittelconnect (idempotent).
      set -euo pipefail
      device="${volume_device}"
      for _ in $(seq 1 60); do
        [ -b "$device" ] && break
        sleep 2
      done
      [ -b "$device" ] || { echo "data volume $device did not appear" >&2; exit 1; }
      blkid "$device" >/dev/null 2>&1 || mkfs.ext4 -L mcdata "$device"
      uuid="$(blkid -s UUID -o value "$device")"
      mkdir -p /srv/mittelconnect
      if ! grep -q "$uuid" /etc/fstab; then
        echo "UUID=$uuid /srv/mittelconnect ext4 defaults,nofail,nodev,nosuid,noexec 0 2" >> /etc/fstab
      fi
      mountpoint -q /srv/mittelconnect || mount /srv/mittelconnect

  - path: /usr/local/sbin/mc-wireguard-setup
    permissions: "0750"
    content: |
      #!/bin/bash
      # Creates this host's WireGuard key (never leaves the host) and wg0.conf.
      set -euo pipefail
      umask 077
      cd /etc/wireguard
      [ -s server.key ] || wg genkey > server.key
      wg pubkey < server.key > server.pub
      chmod 0644 server.pub
      {
        echo "[Interface]"
        echo "Address = ${wg_address}"
        echo "ListenPort = ${wg_port}"
        echo "PrivateKey = $(cat server.key)"
        echo
        echo "[Peer]"
        echo "# Plant ${site_name}"
        echo "PublicKey = ${plant_wg_public_key}"
        echo "AllowedIPs = ${wg_peer_address}, ${plant_lan_cidrs}"
        if [ -n "${plant_endpoint}" ]; then
          echo "Endpoint = ${plant_endpoint}"
        fi
        echo "PersistentKeepalive = 25"
      } > wg0.conf
      chmod 0600 wg0.conf

  - path: /usr/local/sbin/mc-install-docker
    permissions: "0750"
    content: |
      #!/bin/bash
      # Docker Engine and Compose plugin from Docker's signed apt repository.
      set -euo pipefail
      install -m 0755 -d /etc/apt/keyrings
      curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
      chmod a+r /etc/apt/keyrings/docker.asc
      # shellcheck disable=SC1091
      codename="$(. /etc/os-release && echo "$VERSION_CODENAME")"
      echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $codename stable" \
        > /etc/apt/sources.list.d/docker.list
      apt-get update
      DEBIAN_FRONTEND=noninteractive apt-get install -y \
        docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
      systemctl enable --now docker

runcmd:
  - [sysctl, --system]
  - [/usr/local/sbin/mc-mount-data]
  - [/usr/local/sbin/mc-install-docker]
  - [usermod, -aG, docker, deploy]
  - [install, -d, -m, "0755", -o, deploy, -g, deploy, /srv/mittelconnect/app]
  - [install, -d, -m, "0750", -o, root, -g, deploy, /srv/mittelconnect/site]
  - [/usr/local/sbin/mc-wireguard-setup]
  - [systemctl, enable, --now, wg-quick@wg0]
  - [systemctl, enable, --now, fail2ban]
  - [systemctl, enable, --now, unattended-upgrades]
  - [systemctl, restart, ssh]

final_message: "MittelConnect host ${site_name} ready after $UPTIME seconds"
